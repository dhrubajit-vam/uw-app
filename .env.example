# Copy this file to .env and fill in real values. .env is git-ignored.
# Used by scoring/ai_narrator.py to turn the deterministic recommendation
# and explainability data into polished underwriter-facing narrative text.
# The app runs fine without this configured - it just falls back to the
# plain rule-based text everywhere the AI narrative would otherwise appear.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_MODEL_NAME=gpt-4o
